---
import '../styles/global.css';
const { title, description = "Guindonville, Val-David, 2003 : sept petites maisons, dix locataires, un stationnement. Le site de la résistance, reconstitué à partir des archives.", current = '' } = Astro.props;
const nav = [
  ['/', 'Accueil'],
  ['/histoire/', 'Histoire'],
  ['/affaire/', "L'affaire"],
  ['/chronologie/', 'Chronologie'],
  ['/le-6-juillet/', 'Le 6 juillet'],
  ['/photos/', 'Photos'],
  ['/film/', 'Le film'],
  ['/textes/', 'Textes'],
  ['/voix/', 'Voix'],
  ['/presse/', 'Presse'],
  ['/english/', 'English'],
];
const fullTitle = title ? `${title} · Guindonville` : 'Guindonville — Val-David, 2003';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/img/kathy-toit-baril.jpg" />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="site">
      <div class="site-inner">
        <a class="brand" href="/">
          <img src="/img/logo-guindonville.png" alt="" width="44" height="36" />
          <span><strong>Guindonville</strong><small>Val-David · 2003</small></span>
        </a>
        <nav class="main" aria-label="Principale">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="site">
      <div class="site-inner">
        <p>Site original (2003) réalisé par les locataires de Guindonville et leurs sympathisants, hébergé à l'époque à l'adresse guindonville.ca.tc. Reconstitué en 2026 à partir des copies conservées par la Wayback Machine (Internet Archive), avec les textes, les photos et la revue de presse d'origine.</p>
        <p>Les textes d'époque sont reproduits tels quels : ils reflètent le point de vue des locataires et de leurs appuis en 2003. Les faits datés recoupent les archives municipales, Le Devoir et le reportage de Zone Libre (Radio-Canada).</p>
        <p>Photos : locataires et sympathisants de Guindonville, 2003. Images du film : Christian Brochu, 2003.</p>
      </div>
    </footer>
    <div class="lb" id="lb" hidden aria-modal="true" role="dialog" aria-label="Photo en grand">
      <button class="lb-x" type="button" aria-label="Fermer">×</button>
      <button class="lb-prev" type="button" aria-label="Photo précédente">‹</button>
      <figure><img alt="" /><figcaption></figcaption></figure>
      <button class="lb-next" type="button" aria-label="Photo suivante">›</button>
    </div>
    <script is:inline>
    (function(){
      var lb=document.getElementById('lb'); if(!lb) return;
      var img=lb.querySelector('img'), cap=lb.querySelector('figcaption'), items=[], i=0, lastFocus=null;
      document.querySelectorAll('main img').forEach(function(el){
        if(el.closest('a')) return;
        var fc=el.closest('figure'), c=fc&&fc.querySelector('figcaption'), h=el.closest('.house'), hs=h&&h.querySelector('strong');
        items.push({el:el, cap:c?c.innerText:(hs?hs.innerText:(el.alt||''))});
      });
      function show(k){ i=(k+items.length)%items.length; var it=items[i]; img.src=it.el.currentSrc||it.el.src; img.alt=it.el.alt||''; cap.textContent=it.cap; }
      function open(k){ lastFocus=document.activeElement; show(k); lb.hidden=false; document.documentElement.style.overflow='hidden'; lb.querySelector('.lb-x').focus(); }
      function close(){ lb.hidden=true; img.removeAttribute('src'); document.documentElement.style.overflow=''; if(lastFocus) lastFocus.focus(); }
      items.forEach(function(it,k){ it.el.style.cursor='zoom-in'; it.el.addEventListener('click',function(e){ e.preventDefault(); open(k); }); });
      lb.querySelector('.lb-x').onclick=close;
      lb.querySelector('.lb-prev').onclick=function(e){e.stopPropagation();show(i-1);};
      lb.querySelector('.lb-next').onclick=function(e){e.stopPropagation();show(i+1);};
      lb.addEventListener('click',function(e){ if(e.target===lb) close(); });
      document.addEventListener('keydown',function(e){ if(lb.hidden) return; if(e.key==='Escape') close(); else if(e.key==='ArrowRight') show(i+1); else if(e.key==='ArrowLeft') show(i-1); });
      var x0=null; lb.addEventListener('touchstart',function(e){x0=e.touches[0].clientX;},{passive:true});
      lb.addEventListener('touchend',function(e){ if(x0===null) return; var dx=e.changedTouches[0].clientX-x0; if(Math.abs(dx)>50) show(dx<0?i+1:i-1); x0=null; });
    })();
    </script>
  </body>
</html>
